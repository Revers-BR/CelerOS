# ES3C28P (N16R8): 16MB QIO + PSRAM 8MB OCTAL
# Carimbo da placa: o main/CMakeLists.txt recusa build com CELEROS_BOARD
# diferente (sdkconfig de outra placa nunca mais passa calado).
CONFIG_CELEROS_SDKCONFIG_BOARD="es3c28p"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# O conector da placa e so o CH340 (UART). USB nativo desligado; o celerctl
# roda sobre a UART (SerialLink).
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Desempenho: 16MB de flash sobram — Duktape e desenho ganham com -O2.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set

# Celer Link (BLE): NimBLE enxuto, 2 conexoes, 4 papeis.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_CELEROS_BLE_HID=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# CONFIG_BT_NIMBLE_ANS_SERVICE is not set
# CONFIG_BT_NIMBLE_BAS_SERVICE is not set
# CONFIG_BT_NIMBLE_CTS_SERVICE is not set
# CONFIG_BT_NIMBLE_DIS_SERVICE is not set
# CONFIG_BT_NIMBLE_HR_SERVICE is not set
# CONFIG_BT_NIMBLE_HTP_SERVICE is not set
# CONFIG_BT_NIMBLE_IAS_SERVICE is not set
# CONFIG_BT_NIMBLE_IPSS_SERVICE is not set
# CONFIG_BT_NIMBLE_LLS_SERVICE is not set
# CONFIG_BT_NIMBLE_PROX_SERVICE is not set
# CONFIG_BT_NIMBLE_SPS_SERVICE is not set
# CONFIG_BT_NIMBLE_TPS_SERVICE is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_CTRL_BLE_MAX_ACT=4
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=30
CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=10
# CONFIG_BT_CTRL_DTM_ENABLE is not set

CONFIG_CELEROS_LOG_RING=8192
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# Cache de instrucao de 32 KB: o executor do Duktape e grande e, com 16 KB,
# trocava de linha o tempo todo buscando codigo na flash.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Servicos de apps em segundo plano (svchost) ligados; app em task propria
# desligado (as duas opcoes sao exclusivas no Kconfig).
CONFIG_CELEROS_APP_SERVICES=y
# CONFIG_CELEROS_APP_TASK is not set

# CONFERIR: a placa tem codec de audio com microfone? Se for usar, ligar
# CONFIG_CELEROS_MIC=y e preencher .mic no perfil do Board.cpp.
# CONFIG_CELEROS_MIC is not set

# Emulador de NES (Anemoia): ROM + frame na PSRAM, funciona em qualquer S3.